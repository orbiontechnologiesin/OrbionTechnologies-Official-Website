# Orbion Technologies Environment Variables Template
# Copy to .env.local for local development. NEVER commit real secrets or production credentials.

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://orbiontechnologies.in

# Server Port (optional, default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# -----------------------------------------------------------------------------
# Neon PostgreSQL Database Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Obtained from: Neon Console > Project (OrbionTechnologies) > Connection Details
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Better Auth Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Secure random 32-byte secret for token signing and password hashing
# Generate locally via: openssl rand -hex 32
BETTER_AUTH_SECRET="your-secure-32-byte-better-auth-secret"

# Auth Base URL (must match the canonical app domain)
# Local: http://localhost:3000 | Production: https://orbiontechnologies.in
BETTER_AUTH_URL="http://localhost:3000"
