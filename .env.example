# Orbion Technologies Environment Variables Template
# Copy to .env or .env.local for local development. NEVER commit real secrets or production credentials.

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://orbion.in

# Server Port (optional, default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# -----------------------------------------------------------------------------
# Supabase Backend Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Obtained from: Supabase Dashboard > Project Settings > API
#
# Project URL (OrbionTechnologies.com)
NEXT_PUBLIC_SUPABASE_URL="https://hmhcmwvbkgdfkfzcpfgo.supabase.co"

# Supabase Public API Key (Publishable / Anon key - safe for browser exposure)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# Backward-compatibility alias (some Supabase tools reference ANON_KEY)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# -----------------------------------------------------------------------------
# Server-Only Credentials (NEVER expose with NEXT_PUBLIC_ prefix)
# -----------------------------------------------------------------------------
# Service Role Secret (used exclusively for backend administrative tasks or cron jobs)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
