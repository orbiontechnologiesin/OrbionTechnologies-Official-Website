# Orbion Technologies Environment Variables Template
# Copy to .env.local for local development. NEVER commit real secrets or production credentials.

# Canonical Site URL
# Local: http://localhost:3000 | Production: https://orbiontechnologies.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server Port (optional, default: 3000)
PORT=3000

# Node Environment (development | production | test)
NODE_ENV=development

# -----------------------------------------------------------------------------
# Supabase PostgreSQL Database Configuration (Prisma 6 Dual-Connection Architecture)
# -----------------------------------------------------------------------------
# 1. DATABASE_URL: Supabase Transaction Pooler (Port 6543)
# Used by Next.js runtime and Prisma Client queries.
# Must include ?pgbouncer=true&sslmode=require
# Format: postgresql://[user].[project-ref]:[password]@[pooler-host]:6543/[dbname]?pgbouncer=true&sslmode=require
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# 2. DIRECT_URL: Supabase Session Pooler or Direct Connection (Port 5432)
# Used by Prisma CLI for migrations, schema push, and introspection.
# Format: postgresql://[user].[project-ref]:[password]@[pooler-host]:5432/[dbname]?sslmode=require
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# -----------------------------------------------------------------------------
# Better Auth Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Secure random 32-byte secret for token signing and password hashing
# Generate locally via: openssl rand -hex 32
BETTER_AUTH_SECRET="your-secure-32-byte-better-auth-secret"

# Auth Base URL (must match the canonical app domain)
# Local: http://localhost:3000 | Production: https://orbiontechnologies.in
BETTER_AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Supabase Project Identifiers (Optional for Prisma-only database layer)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[YOUR-SUPABASE-ANON-KEY]"
