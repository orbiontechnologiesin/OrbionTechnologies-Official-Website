# ==============================================================================
# ORBION TECHNOLOGIES — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local, .env.production, or any secret-bearing file to git.
# All environment variables are validated at runtime via src/lib/env.ts.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE PUBLIC CREDENTIALS (Client & Server Safe)
# ------------------------------------------------------------------------------
# Exposed to the browser via NEXT_PUBLIC_.
# Enforced by Row Level Security (RLS) on all PostgreSQL tables.

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Publishable / Anon Key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. SUPABASE PRIVATE CREDENTIALS (Strictly Server-Side Only)
# ------------------------------------------------------------------------------
# CRITICAL SECURITY WARNING:
# NEVER prefix the secret key with NEXT_PUBLIC_.
# Bypasses RLS. Used exclusively in server-only modules (src/lib/supabase/admin.ts).

# Your Supabase Secret / Service Role Key
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL (Resend)
# ------------------------------------------------------------------------------
# Used for customer receipts, internal lead notifications, and demo alerts.
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Verified sender email address (configured in Resend domains)
ORBION_SENDER_EMAIL=Orbion Technologies <notifications@orbiontechnologies.in>

# Recipient email address for inbound business leads and notifications
ORBION_CONTACT_EMAIL=enquiry@orbiontechnologies.in

# ------------------------------------------------------------------------------
# 4. BACKGROUND JOB & WORKER SECURITY
# ------------------------------------------------------------------------------
# Bearer secret required to trigger the email outbox processor
# Endpoint: POST /api/jobs/process-email-outbox (Header: Authorization: Bearer <secret>)
EMAIL_JOB_SECRET=generate-a-strong-random-secret-token

# Cryptographic secret for signing newsletter unsubscribe tokens
UNSUBSCRIBE_SIGNING_SECRET=generate-a-strong-secret-for-hmac

# ------------------------------------------------------------------------------
# 5. BOT DEFENSE & SPAM PROTECTION (Optional Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# Leave empty to run with native honeypot and rate limiting.
# Obtain from Cloudflare Dashboard -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 6. SITE URL & HOSTING CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
